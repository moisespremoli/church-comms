# ─────────────────────────────────────────────────────────────────────────────
# CHURCH COMMS — variáveis de ambiente
# Copiar para .env.local e preencher. NUNCA fazer commit de .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública (publishable / anon). É segura no browser porque a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (secret / service_role). APENAS no servidor.
# Usada só pela administração (criar utilizadores, ler emails). Sem prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública da aplicação (links de recuperação de palavra-passe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Fases seguintes (ainda não usadas) ───────────────────────────────────────
# Fase 2 — Web Push
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tecnico@igreja.example
# Fase 3 — LiveKit
# LIVEKIT_URL=wss://<projeto>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
